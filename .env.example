# Template de ambiente para rodar o backend FORA do Docker (dev local).
# Quando rodando via docker-compose raiz, estas variáveis vêm do `.env` raiz.
# Copie para `.env` e preencha. NUNCA commite o `.env`.

DB_URL=jdbc:postgresql://localhost:5432/estacioneja
DB_USER=estacioneja
DB_PASSWORD=troque-esta-senha

# Gere com: openssl rand -base64 64
JWT_SECRET=troque-este-segredo-jwt

# Gere com: openssl rand -hex 32
INTERNAL_SIGNATURE_SECRET=troque-este-segredo-interno

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cloudflare R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=estacioneja-bkt
